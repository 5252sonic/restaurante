<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Control de Acceso - Restaurante Escolar</title>
    <!-- Librería para Lector de Cámara y Exportación a Excel nativo -->
    <script src="https://unpkg.com/html5-qrcode"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        :root { 
            --bg-page: #f7f5f0;
            --surface: #ffffff;
            --surface-muted: #efece6;
            --border: #dcd6cd;
            --border-focus: #8c7b6b;
            --text-main: #2b2621;
            --text-muted: #73695e;
            --primary: #4a4035;
            --primary-hover: #362e26;
            --success-bg: #eaf2eb;
            --success-text: #27522d;
            --success-border: #a3c9a8;
            --warning-bg: #fcf6e8;
            --warning-text: #6e521c;
            --warning-border: #e0ca9b;
            --danger-bg: #fcebe8;
            --danger-text: #6e221c;
            --danger-border: #e0a39b;
        }

        * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; }
        body { background-color: var(--bg-page); color: var(--text-main); padding: 30px 15px; }

        .header { text-align: center; margin-bottom: 25px; }
        .header h1 { font-size: 1.5rem; font-weight: 600; color: var(--text-main); letter-spacing: -0.01em; }
        .header p { color: var(--text-muted); font-size: 0.85rem; margin-top: 4px; }

        /* Navegación Minimalista Neutral */
        .nav-tabs { display: flex; justify-content: center; gap: 6px; margin-bottom: 25px; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
        .tab-btn { 
            padding: 8px 16px; font-size: 0.85rem; border: none; background: transparent; color: var(--text-muted); 
            cursor: pointer; border-radius: 6px; font-weight: 500; transition: all 0.2s ease; 
        }
        .tab-btn:hover { background: var(--surface-muted); color: var(--text-main); }
        .tab-btn.active { background: var(--primary); color: #ffffff; }

        .tab-content { display: none; max-width: 580px; margin: 0 auto; background: var(--surface); padding: 25px; border-radius: 10px; border: 1px solid var(--border); box-shadow: 0 2px 6px rgba(0,0,0,0.02); }
        .tab-content.active { display: block; }

        .form-group { margin-bottom: 16px; }
        label { display: block; margin-bottom: 5px; font-size: 0.8rem; font-weight: 600; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.03em; }
        input, select { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.9rem; background: var(--surface); color: var(--text-main); }
        input:focus, select:focus { border-color: var(--border-focus); outline: none; }
        
        .row-group { display: flex; gap: 10px; }
        .row-group > div { flex: 1; }

        .btn { width: 100%; padding: 11px; border: 1px solid transparent; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s; margin-top: 6px; }
        .btn-primary { background: var(--primary); color: #ffffff; }
        .btn-primary:hover { background: var(--primary-hover); }
        .btn-secondary { background: var(--surface-muted); color: var(--text-main); border-color: var(--border); }
        .btn-secondary:hover { background: var(--border); }
        .btn-danger { background: transparent; color: var(--danger-text); border-color: var(--danger-border); }

        .course-generator-box { background: var(--bg-page); padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid var(--border); }

        /* Carnet Escolar */
        #qr-card-container {
            margin: 20px auto 15px auto; width: 280px; background: #ffffff; border-radius: 8px;
            border: 1px solid var(--border); overflow: hidden; display: none; text-align: center;
        }
        .carnet-header { background: var(--primary); color: #ffffff; padding: 10px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
        .carnet-body { padding: 20px 15px; }
        #card-name { color: var(--text-main); font-size: 1.1rem; font-weight: 600; margin-bottom: 2px; }
        #card-grade { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 10px; }
        
        #qrcode-wrapper { display: flex; justify-content: center; align-items: center; margin: 10px 0; }
        #qr-img-element { width: 160px; height: 160px; border: 1px solid var(--border); padding: 8px; background: #ffffff; }
        #card-id-text { font-size: 0.8rem; color: var(--text-muted); font-weight: 500; margin-top: 6px; }

        /* Contenedor de Cámara */
        #reader { width: 100%; border-radius: 8px; overflow: hidden; background: #000000; min-height: 250px; margin-top: 12px; }
        #reader video { transform: scaleX(-1); -webkit-transform: scaleX(-1); }

        #status-overlay { margin-top: 15px; padding: 14px; border-radius: 6px; text-align: center; font-size: 0.95rem; font-weight: 600; display: none; }
        .status-success { background-color: var(--success-bg); color: var(--success-text); border: 1px solid var(--success-border); }
        .status-duplicate { background-color: var(--warning-bg); color: var(--warning-text); border: 1px solid var(--warning-border); }
        .status-error { background-color: var(--danger-bg); color: var(--danger-text); border: 1px solid var(--danger-border); }

        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 10px; text-align: center; border-bottom: 1px solid var(--border); font-size: 0.85rem; }
        th { background: var(--bg-page); color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 0.7rem; }
        .total-box { margin-top: 15px; text-align: right; font-size: 0.95rem; font-weight: 700; color: var(--text-main); }
    </style>
</head>
<body>

    <div class="header">
        <h1>Restaurante Escolar</h1>
        <p>Control de Ingreso y Registro de Asistencia</p>
    </div>

    <div class="nav-tabs">
        <button class="tab-btn active" onclick="switchTab('registro', event)">Generación de Carnet</button>
        <button class="tab-btn" onclick="switchTab('escaner', event)">Lector de Ingreso</button>
        <button class="tab-btn" onclick="switchTab('reportes', event)">Reportes de Asistencia</button>
    </div>

    <!-- PESTAÑA 1 -->
    <div id="tab-registro" class="tab-content active">
        <div class="course-generator-box">
            <label>Generador de Cursos por Rango</label>
            <div class="row-group">
                <div><input type="number" id="gen-grade" placeholder="Grado (Ej. 6)"></div>
                <div><input type="number" id="gen-count" placeholder="Cantidad (Ej. 3)"></div>
            </div>
            <button type="button" class="btn btn-secondary" onclick="generateCourses()">Añadir Cursos a la Lista</button>
        </div>

        <h2 style="font-size: 1rem; font-weight: 600; margin-bottom: 14px; color: var(--text-main);">Datos del Estudiante</h2>
        <form id="student-form">
            <div class="form-group">
                <label>Código o Identificación</label>
                <input type="text" id="student-id" placeholder="Ej. 1001" required>
            </div>
            <div class="form-group">
                <label>Nombre Completo</label>
                <input type="text" id="student-name" placeholder="Ej. María Camila Pérez" required>
            </div>
            <div class="form-group">
                <label>Curso / Grado</label>
                <div class="row-group">
                    <div>
                        <select id="student-grade-select">
                            <option value="">Seleccionar curso...</option>
                        </select>
                    </div>
                    <div>
                        <input type="text" id="student-grade-custom" placeholder="O escribir (Ej. 601)">
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Generar Código QR</button>
        </form>

        <!-- Carnet -->
        <div id="qr-card-container">
            <div class="carnet-header">Restaurante Escolar — Carnet Digital</div>
            <div class="carnet-body">
                <div id="card-name"></div>
                <div id="card-grade"></div>
                <div id="qrcode-wrapper">
                    <img id="qr-img-element" src="" alt="Código QR">
                </div>
                <div id="card-id-text"></div>
            </div>
        </div>
        
        <div id="download-section" style="display: none; max-width: 280px; margin: 10px auto 0 auto;">
            <a id="btn-download-link" download="Carnet.png" class="btn btn-secondary" style="display: block; text-align: center; text-decoration: none;">Descargar Imagen de Carnet</a>
        </div>
    </div>

    <!-- PESTAÑA 2 -->
    <div id="tab-escaner" class="tab-content">
        <h2 style="font-size: 1rem; font-weight: 600; margin-bottom: 4px; color: var(--text-main);">Escáner de Código QR</h2>
        <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 14px;">Presente el código QR frente a la cámara.</p>
        
        <div style="margin-bottom: 10px;">
            <button id="btn-start-cam" class="btn btn-primary" onclick="initScanner()">Activar Cámara</button>
            <button id="btn-stop-cam" class="btn btn-secondary" onclick="stopScanner()" style="display:none;">Detener Cámara</button>
        </div>

        <div style="background: var(--bg-page); padding: 12px; border-radius: 6px; margin-bottom: 12px; border: 1px solid var(--border);">
            <label style="font-size: 0.75rem; margin-bottom: 4px;">Cargar imagen con código QR (Alternativa)</label>
            <input type="file" id="qr-input-file" accept="image/*" onchange="scanImageFile(this)">
        </div>

        <div id="reader"></div>
        <div id="status-overlay"></div>
    </div>

    <!-- PESTAÑA 3 -->
    <div id="tab-reportes" class="tab-content">
        <h2 style="font-size: 1rem; font-weight: 600; margin-bottom: 14px; color: var(--text-main);">Registro de Ingresos del Día</h2>
        <table>
            <thead>
                <tr><th>Curso</th><th>Estudiantes Ingresados</th></tr>
            </thead>
            <tbody id="count-table"></tbody>
        </table>
        <div class="total-box">Total Ingresos Hoy: <span id="total-count">0</span></div>
        <br>
        <div style="display: flex; gap: 8px;">
            <button class="btn btn-primary" onclick="exportToExcel()" style="flex: 2;">Exportar a Excel (.xlsx)</button>
            <button class="btn btn-danger" onclick="clearDailyRecords()" style="flex: 1;">Reiniciar Día</button>
        </div>
    </div>

    <script>
        function generateQRBase64(text) {
            return "https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=" + encodeURIComponent(text);
        }

        let studentsDB = JSON.parse(localStorage.getItem('studentsDB')) || {};
        let attendanceLogs = JSON.parse(localStorage.getItem('attendanceLogs')) || [];
        let availableCourses = JSON.parse(localStorage.getItem('availableCourses')) || ["601", "602", "701", "702", "801"];

        function renderCourseOptions() {
            const select = document.getElementById('student-grade-select');
            if (!select) return;
            select.innerHTML = '<option value="">Seleccionar curso...</option>';
            availableCourses.sort().forEach(course => {
                select.innerHTML += `<option value="${course}">${course}</option>`;
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderCourseOptions();
        });

        function generateCourses() {
            const grade = parseInt(document.getElementById('gen-grade').value);
            const count = parseInt(document.getElementById('gen-count').value);
            if (!grade || !count) return alert("Ingrese un grado y cantidad válidos.");
            for (let i = 1; i <= count; i++) {
                const code = `${grade}${i < 10 ? '0' + i : i}`;
                if (!availableCourses.includes(code)) availableCourses.push(code);
            }
            localStorage.setItem('availableCourses', JSON.stringify(availableCourses));
            renderCourseOptions();
            alert("Cursos añadidos correctamente.");
            document.getElementById('gen-grade').value = "";
            document.getElementById('gen-count').value = "";
        }

        function switchTab(tabName, event) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(`tab-${tabName}`).classList.add('active');
            if(event) event.target.classList.add('active');
            if (tabName !== 'escaner') stopScanner();
            if (tabName === 'reportes') updateReports();
        }

        document.getElementById('student-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const id = document.getElementById('student-id').value.trim();
            const name = document.getElementById('student-name').value.trim();
            const selected = document.getElementById('student-grade-select').value;
            const custom = document.getElementById('student-grade-custom').value.trim();
            const grade = custom !== "" ? custom : selected;

            if (!grade) return alert("Seleccione o escriba un curso.");

            if (custom !== "" && !availableCourses.includes(custom)) {
                availableCourses.push(custom);
                localStorage.setItem('availableCourses', JSON.stringify(availableCourses));
                renderCourseOptions();
            }

            studentsDB[id] = { name, grade };
            localStorage.setItem('studentsDB', JSON.stringify(studentsDB));

            const qrUrl = generateQRBase64(id);
            const qrImg = document.getElementById('qr-img-element');
            qrImg.src = qrUrl;

            document.getElementById('card-name').innerText = name;
            document.getElementById('card-grade').innerText = `Curso: ${grade}`;
            document.getElementById('card-id-text').innerText = `Cód. Estudiante: ${id}`;
            
            document.getElementById('qr-card-container').style.display = 'block';
            
            const downloadBtn = document.getElementById('btn-download-link');
            downloadBtn.href = qrUrl;
            downloadBtn.target = "_blank";
            document.getElementById('download-section').style.display = 'block';
        });

        let html5QrCodeInstance = null;
        let isProcessingScan = false;

        // Solicitud y activación directa de cámara
        function initScanner() {
            if (html5QrCodeInstance) return;

            html5QrCodeInstance = new Html5Qrcode("reader");
            
            html5QrCodeInstance.start(
                { facingMode: "environment" },
                { fps: 15, qrbox: { width: 220, height: 220 } },
                onScanSuccess
            ).then(() => {
                document.getElementById('btn-start-cam').style.display = 'none';
                document.getElementById('btn-stop-cam').style.display = 'block';
            }).catch(err => {
                alert("No se pudo acceder a la cámara. Verifique los permisos en el navegador.");
                html5QrCodeInstance = null;
            });
        }

        function stopScanner() {
            if (html5QrCodeInstance) {
                html5QrCodeInstance.stop().then(() => {
                    html5QrCodeInstance = null;
                    document.getElementById('btn-start-cam').style.display = 'block';
                    document.getElementById('btn-stop-cam').style.display = 'none';
                }).catch(err => {
                    html5QrCodeInstance = null;
                });
            }
        }

        function scanImageFile(input) {
            if (input.files.length === 0) return;
            const imageFile = input.files[0];
            const scanner = new Html5Qrcode("reader");
            scanner.scanFile(imageFile, true)
                .then(decodedText => { onScanSuccess(decodedText); })
                .catch(err => { alert("No se detectó un código QR válido en la imagen."); });
        }

        function playSound(type) {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain); gain.connect(ctx.destination);
                osc.frequency.setValueAtTime(type === 'success' ? 587.33 : 220, ctx.currentTime);
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                osc.start(); osc.stop(ctx.currentTime + 0.3);
            } catch(e) {}
        }

        function onScanSuccess(decodedText) {
            if (isProcessingScan) return;
            isProcessingScan = true;

            const studentId = decodedText.trim();
            const overlay = document.getElementById('status-overlay');
            const todayStr = new Date().toISOString().split('T')[0];
            overlay.style.display = 'block';

            if (studentsDB[studentId]) {
                const student = studentsDB[studentId];
                const alreadyEntered = attendanceLogs.find(log => log.id === studentId && log.date === todayStr);

                if (alreadyEntered) {
                    playSound('error');
                    overlay.className = "status-duplicate";
                    overlay.innerHTML = `INGRESO REGISTRADO PREVIAMENTE<br><strong>${student.name}</strong> (${student.grade})<br><small>Hora de acceso: ${alreadyEntered.time}</small>`;
                } else {
                    const now = new Date();
                    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    attendanceLogs.push({ id: studentId, name: student.name, grade: student.grade, date: todayStr, time: timeStr });
                    localStorage.setItem('attendanceLogs', JSON.stringify(attendanceLogs));

                    playSound('success');
                    overlay.className = "status-success";
                    overlay.innerHTML = `ACCESO AUTORIZADO<br><strong>${student.name}</strong> (${student.grade})<br><small>Hora: ${timeStr}</small>`;
                }
            } else {
                playSound('error');
                overlay.className = "status-error";
                overlay.innerHTML = `CÓDIGO NO REGISTRADO (${studentId})`;
            }

            setTimeout(() => {
                overlay.style.display = 'none';
                isProcessingScan = false;
            }, 3000);
        }

        function updateReports() {
            const tbody = document.getElementById('count-table');
            tbody.innerHTML = "";
            const todayStr = new Date().toISOString().split('T')[0];
            const todayLogs = attendanceLogs.filter(log => log.date === todayStr);

            const countsByGrade = {};
            todayLogs.forEach(log => { countsByGrade[log.grade] = (countsByGrade[log.grade] || 0) + 1; });

            let total = 0;
            const sortedGrades = Object.keys(countsByGrade).sort();
            if (sortedGrades.length === 0) {
                tbody.innerHTML = `<tr><td colspan="2" style="color: var(--text-muted);">Sin registros de ingreso el día de hoy.</td></tr>`;
            } else {
                sortedGrades.forEach(grade => {
                    const count = countsByGrade[grade];
                    total += count;
                    tbody.innerHTML += `<tr><td><strong>Curso ${grade}</strong></td><td>${count}</td></tr>`;
                });
            }
            document.getElementById('total-count').innerText = total;
        }

        // Exportación directa a Excel en formato .xlsx
        function exportToExcel() {
            const todayStr = new Date().toISOString().split('T')[0];
            const todayLogs = attendanceLogs.filter(log => log.date === todayStr);

            if (todayLogs.length === 0) {
                alert("No hay registros de asistencia para exportar el día de hoy.");
                return;
            }

            if (typeof XLSX === 'undefined') {
                alert("La librería de exportación a Excel requiere conexión a internet para cargar por primera vez.");
                return;
            }

            const dataToExport = todayLogs.map(log => ({
                "Fecha": log.date,
                "Hora de Ingreso": log.time,
                "Código Estudiante": log.id,
                "Nombre Completo": log.name,
                "Curso": log.grade
            }));

            const worksheet = XLSX.utils.json_to_sheet(dataToExport);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "Asistencia Hoy");

            XLSX.writeFile(workbook, `Restaurante_Escolar_${todayStr}.xlsx`);
        }

        function clearDailyRecords() {
            if (confirm("¿Desea reiniciar los registros de asistencia del día de hoy?")) {
                const todayStr = new Date().toISOString().split('T')[0];
                attendanceLogs = attendanceLogs.filter(log => log.date !== todayStr);
                localStorage.setItem('attendanceLogs', JSON.stringify(attendanceLogs));
                updateReports();
            }
        }
    </script>
</body>
</html>
